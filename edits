const qtys = {};
const KEY_MAX = {};

function buildKeyMax() {
  CATALOG.forEach((cat, ti) => {
    cat.groups.forEach((grp, gi) => {
      grp.products.forEach((prod, pi) => {
        const key = ti + "-" + gi + "-" + pi;
        KEY_MAX[key] = (SKU_MAX_QTY[prod.sku] !== undefined) ? SKU_MAX_QTY[prod.sku] : 9999;
      });
    });
  });
}

function availClass(a) {
  if (a === "HIGH") return "badge-HIGH";
  if (a === "MED")  return "badge-MED";
  if (a === "LOW")  return "badge-LOW";
  return "badge-OOS";
}

function isOOS(a) { return !a || a === "OOS"; }

function build() {
  const tabsBar = document.getElementById("tabsBar");
  const panels  = document.getElementById("panels");

  CATALOG.forEach((cat, ti) => {
    const btn = document.createElement("button");
    btn.className = "tab-btn" + (ti === 0 ? " active" : "");
    btn.textContent = cat.tab;
    btn.onclick = () => switchTab(ti);
    tabsBar.appendChild(btn);

    const panel = document.createElement("div");
    panel.className = "panel" + (ti === 0 ? " active" : "");
    panel.id = "panel-" + ti;

    cat.groups.forEach((grp, gi) => {
      const block = document.createElement("div");
      block.className = "group";

      const hdr = document.createElement("div");
      hdr.className = "group-header";
      hdr.innerHTML = "<span>" + grp.name + "</span><span class=\"group-total\" id=\"gt-" + ti + "-" + gi + "\"></span>";
      block.appendChild(hdr);

      grp.products.forEach((prod, pi) => {
        const key = ti + "-" + gi + "-" + pi;
        qtys[key] = 0;
        const oos = isOOS(prod.avail);
        const max = KEY_MAX[key] || 0;

        const row = document.createElement("div");
        row.className = "prow" + (oos ? " oos" : "");
        row.id = "r-" + key;

        const shipTag = prod.ship ? "<span class=\"ship-tag\">Restocks " + prod.ship + "</span>" : "";
        const availQty = max < 9999 ? "<span class=\"pavail\" id=\"avail-" + key + "\">" + max + " avail</span>" : "<span class=\"pavail\" id=\"avail-" + key + "\"></span>";

        row.innerHTML =
          "<div>" +
            "<div class=\"pname\">" + prod.name + "</div>" +
            "<div class=\"psku\">" + prod.sku + shipTag + "</div>" +
            "<div class=\"pmeta\">" +
              "<span class=\"badge " + availClass(prod.avail) + "\">" + (prod.avail || "OOS") + "</span>" +
              availQty +
              (prod.ws > 0 ? "<span class=\"pprice\"><strong>$" + prod.ws.toFixed(2) + "</strong> WS &nbsp;&middot;&nbsp; $" + prod.msrp.toFixed(2) + " MSRP</span>" : "") +
            "</div>" +
          "</div>" +
          "<div class=\"stepper\" id=\"s-" + key + "\">" +
            "<button class=\"sbtn\" onclick=\"bump('" + key + "',-1)\" " + (oos ? "disabled" : "") + ">&minus;</button>" +
            "<input class=\"sval\" type=\"number\" id=\"v-" + key + "\" value=\"0\" min=\"0\" max=\"" + max + "\" " + (oos ? "disabled" : "") + " oninput=\"setQ('" + key + "', parseInt(this.value)||0)\">" +
            "<button class=\"sbtn\" onclick=\"bump('" + key + "',1)\" " + (oos ? "disabled" : "") + ">+</button>" +
          "</div>";

        block.appendChild(row);
      });

      panel.appendChild(block);
    });

    panels.appendChild(panel);
  });

  document.getElementById("orderdate").value = new Date().toISOString().split("T")[0];
}

function switchTab(ti) {
  document.querySelectorAll(".tab-btn").forEach((b, i) => b.classList.toggle("active", i === ti));
  document.querySelectorAll(".panel").forEach((p, i) => p.classList.toggle("active", i === ti));
}

function bump(key, d) {
  const max = KEY_MAX[key] !== undefined ? KEY_MAX[key] : 9999;
  const cur = qtys[key] || 0;
  const next = (d > 0 && cur === 0) ? 3 : cur + d;
  setQ(key, Math.min(max, Math.max(0, next)));
}

function setQ(key, v) {
  const max = KEY_MAX[key] !== undefined ? KEY_MAX[key] : 9999;
  qtys[key] = Math.min(max, Math.max(0, v || 0));
  const inp = document.getElementById("v-" + key);
  const stp = document.getElementById("s-" + key);
  const row = document.getElementById("r-" + key);
  if (inp) inp.value = qtys[key];
  if (stp) stp.classList.toggle("on", qtys[key] > 0);
  if (row) row.classList.toggle("active-row", qtys[key] > 0);
  recalc();
}

function recalc() {
  let totalUnits = 0, totalCost = 0;
  CATALOG.forEach((cat, ti) => {
    cat.groups.forEach((grp, gi) => {
      let gUnits = 0, gCost = 0;
      grp.products.forEach((prod, pi) => {
        const q = qtys[ti + "-" + gi + "-" + pi] || 0;
        if (q > 0 && prod.ws > 0) { gUnits += q; gCost += q * prod.ws; }
      });
      const gt = document.getElementById("gt-" + ti + "-" + gi);
      if (gt) gt.textContent = gUnits > 0 ? gUnits + " units / $" + gCost.toFixed(2) : "";
      totalUnits += gUnits; totalCost += gCost;
    });
  });
  document.getElementById("ftotal-units").textContent = totalUnits + " units";
  document.getElementById("ftotal-cost").textContent = totalCost.toFixed(2);
}

function openModal() {
  document.getElementById("m-customer").textContent = document.getElementById("customer").value || "—";
  document.getElementById("m-rep").textContent      = document.getElementById("salesrep").value || "—";
  document.getElementById("m-po").textContent       = document.getElementById("ponum").value || "—";
  document.getElementById("m-date").textContent     = document.getElementById("orderdate").value || "—";
  document.getElementById("m-shipdate").textContent = document.getElementById("shipdate").value || "—";
  document.getElementById("m-shipto").textContent   = document.getElementById("shipto").value || "—";
  document.getElementById("m-netterms").textContent = document.getElementById("netterms").value || "—";

  const lines = document.getElementById("modal-lines");
  lines.innerHTML = "";
  let grandQty = 0, grandTotal = 0;

  CATALOG.forEach((cat, ti) => {
    let secLines = [], secQty = 0, secTotal = 0;
    cat.groups.forEach((grp, gi) => {
      grp.products.forEach((prod, pi) => {
        const q = qtys[ti + "-" + gi + "-" + pi] || 0;
        if (q > 0 && prod.ws > 0) {
          const amt = q * prod.ws;
          secQty += q; secTotal += amt;
          secLines.push({ name: prod.name, sku: prod.sku, q, amt });
        }
      });
    });
    if (secLines.length) {
      grandQty += secQty; grandTotal += secTotal;
      const sec = document.createElement("div");
      sec.className = "modal-section";
      sec.textContent = cat.tab + " — " + secQty + " units / $" + secTotal.toFixed(2);
      lines.appendChild(sec);
      secLines.forEach(l => {
        const d = document.createElement("div");
        d.className = "modal-line";
        d.innerHTML = "<span>" + l.name + " (" + l.sku + ")</span><span>x" + l.q + " = $" + l.amt.toFixed(2) + "</span>";
        lines.appendChild(d);
      });
    }
  });

  document.getElementById("m-grand").textContent = grandQty + " units / $" + grandTotal.toFixed(2);
  document.getElementById("modalOverlay").classList.add("open");
}

function closeModal() {
  document.getElementById("modalOverlay").classList.remove("open");
}

function saveDraft() {
  const draft = {
    customer: document.getElementById("customer").value,
    salesrep: document.getElementById("salesrep").value,
    ponum:    document.getElementById("ponum").value,
    shipdate: document.getElementById("shipdate").value,
    shipto:   document.getElementById("shipto").value,
    netterms: document.getElementById("netterms").value,
    qtys: qtys
  };
  localStorage.setItem("kaxi_draft", JSON.stringify(draft));
  alert("Draft saved! You can close this tab and come back to continue.");
}

function loadDraft() {
  const saved = localStorage.getItem("kaxi_draft");
  if (!saved) return;
  const draft = JSON.parse(saved);
  if (draft.customer) document.getElementById("customer").value = draft.customer;
  if (draft.salesrep) document.getElementById("salesrep").value = draft.salesrep;
  if (draft.ponum)    document.getElementById("ponum").value    = draft.ponum;
  if (draft.shipdate) document.getElementById("shipdate").value = draft.shipdate;
  if (draft.shipto)   document.getElementById("shipto").value   = draft.shipto;
  if (draft.netterms) document.getElementById("netterms").value = draft.netterms;
  if (draft.qtys) {
    Object.keys(draft.qtys).forEach(k => {
      qtys[k] = draft.qtys[k];
      const inp = document.getElementById("v-" + k);
      if (inp) inp.value = qtys[k];
    });
    recalc();
  }
}

let customerData = {};
let orderedToday = {};

function fetchCustomers() {
  fetch(SHEETS_URL)
    .then(r => r.json())
    .then(data => {
      customerData = data.customers || {};
      orderedToday = data.ordered || {};
      updateAvailableDisplay();
    })
    .catch(() => {});
}

function updateAvailableDisplay() {
  CATALOG.forEach((cat, ti) => {
    cat.groups.forEach((grp, gi) => {
      grp.products.forEach((prod, pi) => {
        const key = ti + "-" + gi + "-" + pi;
        const base = SKU_MAX_QTY[prod.sku] !== undefined ? SKU_MAX_QTY[prod.sku] : 9999;
        const deducted = orderedToday[prod.sku] || 0;
        const available = Math.max(0, base - deducted);
        KEY_MAX[key] = available;
        const el = document.getElementById("avail-" + key);
        if (el) el.textContent = available < 9999 ? available + " avail" : "";
      });
    });
  });
}

function filterCustomers(val) {
  const list = document.getElementById("customer-list");
  if (!val || val.length < 2) { list.style.display = "none"; return; }
  const matches = Object.keys(customerData).filter(k => k.toLowerCase().includes(val.toLowerCase()));
  if (!matches.length) { list.style.display = "none"; return; }
  list.innerHTML = matches.map(k =>
    "<div class=\"autocomplete-item\" onclick=\"selectCustomer('" + k.replace(/'/g, "\'") + "')\">" + k + "</div>"
  ).join("");
  list.style.display = "block";
}

function selectCustomer(name) {
  document.getElementById("customer").value = name;
  document.getElementById("customer-list").style.display = "none";
  if (customerData[name]) document.getElementById("shipto").value = customerData[name];
}

document.addEventListener("click", function(e) {
  if (!e.target.closest(".autocomplete-wrapper")) {
    const list = document.getElementById("customer-list");
    if (list) list.style.display = "none";
  }
});

function submitOrder() {
  const customer = document.getElementById("customer").value || "—";
  const rep      = document.getElementById("salesrep").value || "—";
  const po       = document.getElementById("ponum").value || "—";
  const sd       = document.getElementById("shipdate").value || "—";
  const st       = document.getElementById("shipto").value || "—";
  const od       = document.getElementById("orderdate").value || "—";
  const nt       = document.getElementById("netterms").value || "—";

  // Calculate due date based on net terms
  function getDueDate(orderDate, terms) {
    const d = new Date(orderDate);
    if (terms === "Net 30") d.setDate(d.getDate() + 30);
    else if (terms === "Net 60") d.setDate(d.getDate() + 60);
    else if (terms === "Net 90") d.setDate(d.getDate() + 90);
    return d.toISOString().split("T")[0];
  }
  const dueDate = getDueDate(od, nt);

  let body = "ORDER DETAILS\n";
  body += "================\n";
  body += "Customer: " + customer + "\n";
  body += "Sales Rep: " + rep + "\n";
  body += "PO Number: " + po + "\n";
  body += "Order Date: " + od + "\n";
  body += "Ship Date: " + sd + "\n";
  body += "Ship To: " + st + "\n";
  body += "Net Terms: " + nt + "\n\n";

  let grandQty = 0, grandTotal = 0, hasItems = false;
  const lineItems = [];

  CATALOG.forEach((cat, ti) => {
    let secLines = [], secQty = 0, secTotal = 0;
    cat.groups.forEach((grp, gi) => {
      grp.products.forEach((prod, pi) => {
        const q = qtys[ti + "-" + gi + "-" + pi] || 0;
        if (q > 0 && prod.ws > 0) {
          hasItems = true;
          const amt = q * prod.ws;
          secQty += q; secTotal += amt;
          secLines.push("  " + prod.name + " (" + prod.sku + ") x" + q + " = $" + amt.toFixed(2));
          lineItems.push({ sku: prod.sku, qty: q });
        }
      });
    });
    if (secLines.length) {
      grandQty += secQty; grandTotal += secTotal;
      body += cat.tab.toUpperCase() + " — " + secQty + " units / $" + secTotal.toFixed(2) + "\n";
      body += secLines.join("\n") + "\n\n";
    }
  });

  if (!hasItems) { alert("No items added yet!"); return; }

  body += "================\n";
  body += "TOTAL: " + grandQty + " units / $" + grandTotal.toFixed(2) + "\n";
  body += "\nShip To: " + st;

  // QuickBooks formatted section
  body += "\n\n\n";
  body += "----------------------------------------\n";
  body += "QUICKBOOKS INVOICE\n";
  body += "----------------------------------------\n";
  body += "Customer:      " + customer + "\n";
  body += "Invoice Date:  " + od + "\n";
  body += "Due Date:      " + dueDate + "\n";
  body += "Terms:         " + nt + "\n";
  body += "Ship To:       " + st + "\n";
  body += "PO Number:     " + po + "\n\n";
  body += "PRODUCT                          QTY    UNIT PRICE    AMOUNT\n";
  body += "-------------------------------------------------------------\n";
  CATALOG.forEach((cat, ti) => {
    cat.groups.forEach((grp, gi) => {
      grp.products.forEach((prod, pi) => {
        const q = qtys[ti + "-" + gi + "-" + pi] || 0;
        if (q > 0 && prod.ws > 0) {
          const amt = (q * prod.ws).toFixed(2);
          const name = (prod.name + " (" + prod.sku + ")").padEnd(32, " ").substring(0, 32);
          const qty  = String(q).padStart(4, " ");
          const price = ("$" + prod.ws.toFixed(2)).padStart(10, " ");
          const total = ("$" + amt).padStart(10, " ");
          body += name + " " + qty + " " + price + " " + total + "\n";
        }
      });
    });
  });
  body += "-------------------------------------------------------------\n";
  body += "TOTAL:".padEnd(32, " ") + "      " + ("$" + grandTotal.toFixed(2)).padStart(10, " ") + "\n";
  body += "----------------------------------------\n";

  const payload = {
    date: od, customer, rep, po, shipDate: sd, shipTo: st,
    netTerms: nt, items: body,
    totalUnits: grandQty, totalWholesale: "$" + grandTotal.toFixed(2),
    lineItems: lineItems
  };

  fetch(SHEETS_URL, { method: "POST", body: JSON.stringify(payload) })
    .then(() => { fetchCustomers(); })
    .catch(() => {});

  localStorage.removeItem("kaxi_draft");

  const subject = "Kaxi Wholesale Order — " + customer + " — " + od;
  const mailto = "mailto:kylie@shopkaxi.com?subject=" + encodeURIComponent(subject) + "&body=" + encodeURIComponent(body);
  window.location.href = mailto;
}

buildKeyMax();
build();
recalc();
loadDraft();
fetchCustomers();
