    <div class="modal-field"><span>Ship To</span><span id="m-shipto"></span></div>
    <div class="modal-field"><span>Net Terms</span><span id="m-netterms"></span></div>
    <div id="modal-lines"></div>
    <div class="modal-grand"><span>Total</span><span id="m-grand"></span></div>
    <div class="modal-btns">
      <button class="btn-back"  onclick="closeModal()">&larr; edit</button>
      <button class="btn-draft" onclick="saveDraft()">save draft</button>
      <button class="btn-print" onclick="submitOrder()">submit order</button>
    </div>
  </div>
</div>

